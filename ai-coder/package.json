{
  "name": "ai-coder",
  "version": "0.1.0",
  "description": "Web 界面 + 后端 Agent 的 AI 编程助手（OpenAI 兼容接口）",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p .",
    "serve": "node dist/server.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
