# ===== 模型配置（任意 OpenAI 兼容接口）=====
# DeepSeek:  https://api.deepseek.com/v1           模型 deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen3-coder-plus
# Kimi:      https://api.moonshot.cn/v1            模型 kimi-k2-0905-preview
# OpenAI:    https://api.openai.com/v1             模型 gpt-4.1
# 本地 Ollama: http://localhost:11434/v1           模型 qwen2.5-coder:14b
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxx
MODEL=deepseek-chat

# ===== 运行配置 =====
# Agent 可以操作的项目目录（默认为启动时的当前目录）
WORKSPACE=
PORT=3000
# 默认只监听本机，改成 0.0.0.0 会让局域网可以访问（Agent 能执行命令，谨慎）
HOST=127.0.0.1
# 单次任务最多的模型调用轮数
MAX_STEPS=50
# 单个命令超时（秒）
COMMAND_TIMEOUT=120
