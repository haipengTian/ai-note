# ===== 模型配置（任意 OpenAI 兼容接口）=====
# 推荐在网页右上角「模型设置」中配置：可以为正文、策划、审校、记忆抽取、摘要分别指定不同服务商的模型，
# 保存后生成 models.json（格式见 models.example.json）。有 models.json 时，下面的 OPENAI_BASE_URL / MODEL* / TEMPERATURE / MAX_TOKENS 不再生效，
# 但各服务商的密钥仍然放在本文件里（如 DEEPSEEK_API_KEY=sk-xxx），修改后无需重启。
#
# 没有 models.json 时按下面的旧配置运行：
# DeepSeek:  https://api.deepseek.com/v1                         deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus / qwen-max
# Kimi:      https://api.moonshot.cn/v1                          kimi-k2-0905-preview
# OpenAI:    https://api.openai.com/v1                           gpt-4.1
# 本地 Ollama: http://localhost:11434/v1                          qwen2.5:14b
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxx

# 写正文用的模型（决定文笔，建议用最好的）
MODEL=deepseek-chat
# 写摘要/抽取记忆等“结构化小活”的模型，留空则与 MODEL 相同，可用便宜的模型省钱
MODEL_FAST=
# 审校用的模型，留空则与 MODEL 相同（建议换一家模型，减少“自己审自己”的盲区）
MODEL_REVIEW=
# 章后记忆抽取（状态变化、伏笔）用的模型，决定长篇一致性，留空则与 MODEL 相同
MODEL_MEMORY=

# 创作温度：越高越有想象力，越低越稳定
TEMPERATURE=0.85
# 单次生成最大输出 token（章节正文需要足够大）
MAX_TOKENS=8192

PORT=3000
HOST=127.0.0.1
# 作品数据存放目录
DATA_DIR=./data
# 写作/审校时注入上下文的字符预算（中文约 1 字 ≈ 1 token），按模型上下文长度调整
CONTEXT_BUDGET=60000
